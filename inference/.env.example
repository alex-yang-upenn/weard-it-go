# Copy to .env (never commit .env).

# --- required ---
TURBOPUFFER_API_KEY=
TURBOPUFFER_REGION=gcp-us-central1
REDIS_PASSWORD=change-me
# Set only when Redis is NOT the one in this compose file (e.g. a second GPU box):
# REDIS_URL=redis://:change-me@<redis-host>:6379

# --- models (defaults fit one 24 GB GPU) ---
# VLM_MODEL=Qwen/Qwen3-VL-8B-Instruct-FP8
# EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B
# VLM_GPU_UTIL=0.70
# EMBED_GPU_UTIL=0.15
# VLM_MAX_LEN=8192
# HF_TOKEN=            # only for gated models

# --- queue ---
# STREAM=scenes:index
# GROUP=indexers
# CONCURRENCY=8
# MAX_ATTEMPTS=3
# CLAIM_IDLE_MS=120000
# TPUF_NAMESPACE=scenes
